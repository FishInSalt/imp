{
	"name": "ink-agent",
	"version": "0.2.2",
	"description": "Ink — an open-source AI assistant and agent harness for the terminal",
	"type": "module",
	"license": "MIT",
	"author": "L Z",
	"bin": {
		"ink": "bin/ink.js"
	},
	"files": [
		"bin/ink.js",
		"dist",
		"docs",
		"!docs/design",
		"examples",
		"CHANGELOG.md",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FishInSalt/ink.git"
	},
	"homepage": "https://github.com/FishInSalt/ink#readme",
	"bugs": {
		"url": "https://github.com/FishInSalt/ink/issues"
	},
	"keywords": [
		"ai-assistant",
		"agent-harness",
		"cli",
		"tui",
		"terminal",
		"ai"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsx src/cli.ts",
		"start": "npm run build && node bin/ink.js",
		"package:smoke": "node scripts/package-smoke.mjs",
		"prepare": "npm run build",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
		"lint": "biome check . && npm run lint:scripts",
		"lint:scripts": "node --check scripts/package-smoke.mjs && node --check scripts/release-guards.mjs",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@earendil-works/pi-tui": "0.82.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"typebox": "^1.0.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/node": "^24.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
