{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    },
    "preset": "recommended"
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "test/**/*.ts",
      "bin/**/*.js"
    ]
  }
}
